{
    "name": "nilmarsm86/phpmd-symfony-preset",
    "description": "Rulesets de PHPMD por nivel + herramienta de navegación para PHPStorm, con instalación automática en proyectos Symfony.",
    "type": "composer-plugin",
    "license": "MIT",
	"keywords": ["phpmd"],
	"homepage": "https://github.com/nilmarsm86/phpmd-symfony-preset",
	 "authors": [
        {
            "name": "Nilmar Sanchez Muguercia",
            "email": "nilmarsm86@gmail.com",
            "homepage": "https://www.linkedin.com/in/nilmarsm86/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": "^2.0",
        "phpmd/phpmd": "2.*"
    },
    "require-dev": {
        "composer/composer": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Nilmarsm86\\PhpmdPreset\\": "src/"
        }
    },
    "extra": {
        "class": "Nilmarsm86\\PhpmdPreset\\Plugin"
    },
    "bin": [
        "resources/phpmd-pretty"
    ],
    "minimum-stability": "stable"
}
